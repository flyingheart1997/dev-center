datasource db {
  provider   = "postgresql"
  extensions = [citext(schema: "extensions"), pgcrypto, pg_stat_statements, supabase_vault, uuid_ossp(map: "uuid-ossp")]
}

generator client {
  provider        = "prisma-client"
  output          = "./generated"
  previewFeatures = ["postgresqlExtensions"]
}

enum EmployeeRole {
  Owner
  Global_Admin
  Business_Unit_Admin
  Branch_Admin
  Recruiter
  Interviewer
  Hiring_Manager
}

enum EmployeeStatus {
  Active
  Pending_Approval
}

enum JobStatus {
  Draft
  Pending_Approval
  Active
  Completed
}

enum ApprovalStatus {
  Pending
  Approved
  Rejected
}

enum OfferStatus {
  Draft
  Pending_Approval
  Approved
  Sent
  Accepted
  Rejected
  Withdrawn
}

enum ApplicantStatus {
  Applied
  Screening
  Shortlisted
  Interviewing
  Offer
  OfferAccepted
  OfferRejected
  Hired
  Rejected
  Withdrawn
  OnHold
}

enum Recommendation {
  Strong_Hire
  Hire
  No_Hire
  Strong_No_Hire
}

enum EmploymentType {
  Full_Time
  Part_Time
  Contract
  Internship
}

enum ExperienceLevel {
  Entry
  Mid
  Senior
  Lead
  Executive
}

enum RemoteType {
  Onsite
  Hybrid
  Remote
}

enum RoundCategory {
  Screening
  Technical
  Design
  Behavioral
  Management
}

enum QuestionCategory {
  Coding
  System_Design
  System_Architecture
  Behavioral
  Technical_Theory
  Business_Case
}

enum InterviewStatus {
  Scheduled
  Reschedule_Requested
  Completed
  Cancelled
  Absent
}

enum RescheduleRequestedBy {
  Candidate
  Interviewer
}

enum RescheduleStatus {
  Pending
  Approved
  Rejected
}

enum JobBoardProvider {
  LINKEDIN
  INDEED
  NAUKRI
  MONSTER
  GLASSDOOR
  WELLFOUND
  GREENHOUSE
  LEVER
}

enum ConnectionStatus {
  Connected
  Expired
  Disconnected
}

enum JobBoardPostStatus {
  Pending
  Posted
  Failed
}

enum Difficulty {
  Easy
  Medium
  Hard
}

enum NotificationType {
  System
  Application_Update
  Interview_Scheduled
  Screening_Completed
  Employee_Invite
}

enum Language {
  javascript
  typescript
  python
  go
  java
  cpp
  c
  csharp
  ruby
  rust
  php
}

enum SubmissionStatus {
  Pending
  Running
  Accepted
  Wrong_Answer
  Runtime_Error
  Time_Limit_Exceeded
  Memory_Limit_Exceeded
  Compilation_Error
}

enum AuditEvent {
  PASSWORD_CHANGED
  ROLE_CHANGED
  SESSION_REVOKED
  USER_DISABLED
  MEMBER_INVITED
  EMPLOYEE_STATUS_CHANGED
  EMAIL_VERIFIED
  ORGANIZATION_CREATED
}

model Organization {
  id                String               @id @default(uuid())
  name              String
  domain            String               @unique
  slug              String               @unique
  websiteUrl        String?
  linkedinUrl       String?
  logoUrl           String?
  industry          String?
  dataRetentionDays Int?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  employees         Employee[]
  jobs              Job[]
  connections       JobBoardConnection[]
  subscription      Subscription?
  questions         Question[]
  invitations       EmployeeInvitation[]
  businessUnits     BusinessUnit[]
  branches          Branch[]
  departments       Department[]
  auditLogs         AuditLog[]
  talentPools       TalentPool[]
}

model BusinessUnit {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  slug           String? // nullable — no uniqueness constraint yet, unused until a workspace switcher exists
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branches         Branch[]
  employees        Employee[]
  jobs             Job[]
  connections      JobBoardConnection[]
  invitations      EmployeeInvitation[]
  workspaceMembers EmployeeWorkspace[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// Many-to-many Employee <-> BusinessUnit membership, for a future multi-workspace switcher.
// Deliberately unpopulated for now — Employee.businessUnitId (above) remains the only
// business-unit relationship actually read anywhere until that feature is built.
model EmployeeWorkspace {
  id             String       @id @default(uuid())
  employeeId     String
  businessUnitId String
  role           EmployeeRole @default(Interviewer)
  isActive       Boolean      @default(true)
  assignedAt     DateTime     @default(now())

  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)

  @@unique([employeeId, businessUnitId])
  @@index([employeeId])
  @@index([businessUnitId])
}

model Branch {
  id             String   @id @default(uuid())
  organizationId String
  businessUnitId String
  name           String
  code           String?
  timezone       String   @default("UTC")
  country        String?
  city           String?
  address        String?  @db.Text
  isHeadOffice   Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit         @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  departments  Department[]
  employees    Employee[]
  jobs         Job[]
  connections  JobBoardConnection[]
  invitations  EmployeeInvitation[]

  @@unique([businessUnitId, name])
  @@index([organizationId])
  @@index([businessUnitId])
}

model Department {
  id             String   @id @default(uuid())
  organizationId String
  branchId       String
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  employees    Employee[]
  jobs         Job[]
  invitations  EmployeeInvitation[]

  @@unique([branchId, name])
  @@index([organizationId])
  @@index([branchId])
}

model Employee {
  id                   String                @id @default(uuid())
  organizationId       String
  businessUnitId       String?
  branchId             String?
  departmentId         String?
  userId               String
  role                 EmployeeRole          @default(Interviewer)
  status               EmployeeStatus        @default(Pending_Approval)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit         BusinessUnit?         @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  branch               Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department           Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviews           Interview[]           @relation("InterviewInterviewers")
  scorecards           Scorecard[]
  jobRounds            JobRoundInterviewer[]
  auditLogs            AuditLog[]
  jobApprovals         JobApproval[]
  offerApprovals       OfferApproval[]
  referredApplications Application[]         @relation("ReferredApplications")
  availabilitySlots    AvailabilitySlot[]
  workspaces           EmployeeWorkspace[]

  @@unique([organizationId, userId])
  @@index([businessUnitId])
  @@index([branchId])
  @@index([departmentId])
}

model Job {
  id              String          @id @default(uuid())
  organizationId  String
  businessUnitId  String?
  branchId        String?
  departmentId    String?
  title           String
  description     String
  status          JobStatus       @default(Draft)
  employmentType  EmploymentType  @default(Full_Time)
  experienceLevel ExperienceLevel @default(Mid)
  salaryMin       Float?
  salaryMax       Float?
  currency        String          @default("USD")
  location        String?
  remoteType      RemoteType      @default(Onsite)
  isInternalOnly  Boolean         @default(false)
  publishedAt     DateTime?
  closingDate     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit      BusinessUnit?  @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  branch            Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department        Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  rounds            JobRound[]
  applications      Application[]
  jobBoardPosts     JobBoardPost[]
  skills            JobSkill[]
  approvals         JobApproval[]
  savedByCandidates SavedJob[]

  @@index([organizationId])
  @@index([status])
  @@index([businessUnitId])
  @@index([branchId])
  @@index([departmentId])
}

model JobRound {
  id                  String                @id @default(uuid())
  jobId               String
  orderIndex          Int
  title               String
  category            RoundCategory         @default(Technical)
  durationMinutes     Int?                  @default(45)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  interviews          Interview[]
  interviewers        JobRoundInterviewer[]
  currentApplications Application[]         @relation("CurrentRound")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, orderIndex])
}

model JobRoundInterviewer {
  id         String @id @default(uuid())
  roundId    String
  employeeId String

  round    JobRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([roundId, employeeId])
}

model Candidate {
  id                 String    @id @default(uuid())
  userId             String?   @unique
  experienceYears    Int?
  currentCompany     String?
  currentDesignation String?
  countryPermit      Boolean?
  criminalRecord     Boolean?
  isExistingEmployee Boolean?
  consentGiven       Boolean   @default(false)
  consentTimestamp   DateTime?
  tags               String[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user              User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  applications      Application[]
  skills            CandidateSkill[]
  availabilitySlots AvailabilitySlot[]
  talentPools       TalentPoolCandidate[]
  practiceSessions  PracticeSession[]
  resumeReviews     ResumeReview[]
  savedJobs         SavedJob[]
}

model Application {
  id                      String               @id @default(uuid())
  jobId                   String
  candidateId             String
  referrerId              String?
  currentRoundId          String?
  status                  ApplicantStatus      @default(Applied)
  resumeUrl               String?
  expectedSalary          Float?
  currentSalary           Float?
  noticePeriod            Int? // notice period in days
  source                  String? // e.g. "LinkedIn", "Indeed"
  rejectionReason         String?
  rejectionNotes          String?              @db.Text
  formResponses           Json? // Stores any extra custom form questions
  screeningScore          Int? // Overall AI screening score (0-100)
  allowCrossBranchSharing Boolean              @default(true)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  interviews              Interview[]
  screeningResult         ScreeningResult?
  questionSubmissions     QuestionSubmission[]
  offer                   Offer?

  job          Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  referrer     Employee? @relation("ReferredApplications", fields: [referrerId], references: [id], onDelete: SetNull)
  currentRound JobRound? @relation("CurrentRound", fields: [currentRoundId], references: [id], onDelete: SetNull)

  @@unique([jobId, candidateId])
  @@index([jobId])
  @@index([candidateId])
  @@index([referrerId])
  @@index([status])
  @@index([currentRoundId])
}

model ScreeningResult {
  id               String          @id @default(uuid())
  applicationId    String          @unique
  aiModel          String?
  resumeScore      Int?
  resumeFeedback   String?         @db.Text
  voiceScore       Int?
  voiceFeedback    String?         @db.Text
  voiceTranscript  String?         @db.Text
  codingScore      Int?
  codingFeedback   String?         @db.Text
  codingSourceTree Json? // Candidate source code JSON
  personalityScore Int? // Personality/behavior trait matching
  overallScore     Int? // Aggregated AI score
  recommendation   Recommendation? @default(Hire)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Interview {
  id                  String               @id @default(uuid())
  applicationId       String
  jobRoundId          String
  status              InterviewStatus      @default(Scheduled)
  isRescheduled       Boolean              @default(false)
  startTime           DateTime
  endTime             DateTime
  meetingLink         String?
  livekitRoomId       String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  interviewQuestions  InterviewQuestion[]
  questionSubmissions QuestionSubmission[]
  rescheduleRequests  RescheduleRequest[]

  application  Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  jobRound     JobRound    @relation(fields: [jobRoundId], references: [id], onDelete: Cascade)
  interviewers Employee[]  @relation("InterviewInterviewers")
  scorecards   Scorecard[]

  @@index([startTime])
  @@index([status])
}

model Scorecard {
  id                  String          @id @default(uuid())
  interviewId         String
  interviewerId       String
  technicalScore      Int? // Technical skill rating (e.g. 1-5)
  communicationScore  Int? // Communication rating (e.g. 1-5)
  problemSolvingScore Int? // Problem solving rating (e.g. 1-5)
  cultureScore        Int? // Cultural fit rating (e.g. 1-5)
  overallScore        Int? // Aggregated rating (e.g. 1-5)
  recommendation      Recommendation?
  feedback            String?         @db.Text // Detailed notes
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewer Employee  @relation(fields: [interviewerId], references: [id], onDelete: Cascade)

  @@unique([interviewId, interviewerId])
  @@index([interviewId])
  @@index([interviewerId])
}

model Skill {
  id         String           @id @default(uuid())
  name       String           @unique
  jobs       JobSkill[]
  candidates CandidateSkill[]
}

model JobSkill {
  id      String @id @default(uuid())
  jobId   String
  skillId String

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
  @@index([jobId])
  @@index([skillId])
}

model CandidateSkill {
  id          String @id @default(uuid())
  candidateId String
  skillId     String

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill     Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([candidateId, skillId])
  @@index([candidateId])
  @@index([skillId])
}

model JobBoardConnection {
  id             String           @id @default(uuid())
  organizationId String
  businessUnitId String?
  branchId       String?
  provider       JobBoardProvider
  credentials    Json // Encrypted OAuth credentials or API keys
  status         ConnectionStatus @default(Connected)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([organizationId, provider, businessUnitId, branchId])
  @@index([businessUnitId])
  @@index([branchId])
}

model JobBoardPost {
  id            String             @id @default(uuid())
  jobId         String
  provider      JobBoardProvider
  externalJobId String? // Unique ID returned by external API
  url           String? // External URL to the post
  status        JobBoardPostStatus @default(Pending)
  errorMessage  String?            @db.Text
  postedAt      DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, provider])
}

model Plan {
  id               String         @id @default(uuid())
  name             String         @unique // "Free", "Pro", "Enterprise"
  price            Int // Price in cents (e.g. 0, 14900)
  activeJobsLimit  Int // e.g. 2 for Free, 15 for Pro, -1 for unlimited
  aiCreditsLimit   Int // e.g. 10 for Free, 250 for Pro, -1 for unlimited
  maxBusinessUnits Int            @default(1)
  maxBranches      Int            @default(1)
  maxEmployees     Int            @default(5)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  subscriptions    Subscription[]
}

model Subscription {
  id                     String    @id @default(uuid())
  organizationId         String    @unique
  planId                 String // Required relation to Plan
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)
}

model Question {
  id              String           @id @default(uuid())
  organizationId  String // required, "system" for defaults
  title           String
  description     String           @db.Text
  category        QuestionCategory @default(Coding)
  difficulty      Difficulty       @default(Medium)
  tags            String[]
  languages       Language[]
  timeLimit       Int?
  memoryLimit     Int?
  starterCode     Json?
  solutionCode    Json?
  hint            Json?
  timeComplexity  String?
  spaceComplexity String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  testCaseList QuestionTestCase[]
  submissions  QuestionSubmission[]
  interviews   InterviewQuestion[]

  @@unique([organizationId, title]) // Enforces unique question names per organization/system scope
  @@index([organizationId])
  @@index([category])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  content   String           @db.Text
  isRead    Boolean          @default(false)
  type      NotificationType @default(System)
  actionUrl String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model EmployeeInvitation {
  id             String       @id @default(uuid())
  email          String
  role           EmployeeRole @default(Interviewer)
  token          String       @unique
  organizationId String
  businessUnitId String?
  branchId       String?
  departmentId   String?
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([businessUnitId])
  @@index([branchId])
  @@index([departmentId])
  @@index([expiresAt])
}

// NextAuth standard models
model User {
  id                    String                 @id @default(cuid())
  name                  String?
  email                 String?                @unique @db.Citext
  emailVerified         DateTime?
  hashedPassword        String?
  tokenVersion          Int                    @default(0)
  lastPasswordChangedAt DateTime?
  deletedAt             DateTime?
  image                 String?
  phone                 String?
  linkedinUrl           String?
  githubUrl             String?
  portfolioUrl          String?
  resumeUrl             String?
  location              String?
  accounts              Account[]
  sessions              Session[]
  employees             Employee[] // A user can have one or more Employee profiles
  candidates            Candidate[] // A user can have one or more Candidate profiles
  candidateSubscription CandidateSubscription?
  notifications         Notification[]
  auditLogs             AuditLog[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String    @id @default(cuid())
  sessionToken String    @unique
  userId       String
  expires      DateTime
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(uuid()) // Added for clean mapping
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([identifier])
  @@index([expires])
}

model QuestionTestCase {
  id             String   @id @default(uuid())
  questionId     String
  input          String   @db.Text
  expectedOutput String   @db.Text
  isHidden       Boolean  @default(true)
  weight         Int      @default(1)
  explanation    String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([isHidden])
}

model QuestionSubmission {
  id              String           @id @default(uuid())
  questionId      String
  applicationId   String?
  interviewId     String?
  language        Language
  sourceCode      String           @db.Text
  status          SubmissionStatus
  runtime         Float? // AI-estimated execution time (ms)
  memory          Float? // AI-estimated memory usage (MB)
  score           Float? // Calculated score (0-100 or weighted)
  passedTestCases Int              @default(0)
  totalTestCases  Int              @default(0)
  testCaseResults Json? // Detailed list of passed/failed test cases
  compilerOutput  String?          @db.Text // AI compiler errors / logs
  createdAt       DateTime         @default(now())

  question    Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  interview   Interview?   @relation(fields: [interviewId], references: [id], onDelete: SetNull)

  @@index([questionId])
  @@index([applicationId])
  @@index([interviewId])
  @@index([status])
}

model InterviewQuestion {
  id          String  @id @default(uuid())
  interviewId String
  questionId  String
  order       Int
  maxScore    Float   @default(100)
  score       Float? // Actual score given by AI or interviewer
  notes       String? @db.Text // Interviewer's notes for this question

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  question  Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([interviewId, questionId])
  @@index([questionId])
}

model AuditLog {
  id             String      @id @default(uuid())
  organizationId String?
  employeeId     String?
  userId         String?
  event          AuditEvent?
  action         String // e.g. "JOB_CREATED", "ROLE_UPDATED"
  entityName     String // e.g. "Job", "Application"
  entityId       String
  oldValues      Json?
  newValues      Json?
  ipAddress      String?
  createdAt      DateTime    @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee?     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([employeeId])
  @@index([userId])
  @@index([createdAt])
}

model JobApproval {
  id         String         @id @default(uuid())
  jobId      String
  approverId String
  status     ApprovalStatus @default(Pending)
  feedback   String?        @db.Text
  approvedAt DateTime?

  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  approver Employee @relation(fields: [approverId], references: [id], onDelete: Cascade)

  @@unique([jobId, approverId])
  @@index([approverId])
}

model Offer {
  id              String      @id @default(uuid())
  applicationId   String      @unique
  offeredSalary   Float
  currency        String      @default("USD")
  targetStartDate DateTime
  status          OfferStatus @default(Draft)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  application Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  approvals   OfferApproval[]
}

model OfferApproval {
  id         String         @id @default(uuid())
  offerId    String
  approverId String
  status     ApprovalStatus @default(Pending)
  feedback   String?        @db.Text
  approvedAt DateTime?

  offer    Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  approver Employee @relation(fields: [approverId], references: [id], onDelete: Cascade)

  @@unique([offerId, approverId])
  @@index([approverId])
}

model RescheduleRequest {
  id            String                @id @default(uuid())
  interviewId   String
  requestedById String
  requestedBy   RescheduleRequestedBy
  reason        String                @db.Text
  proposedSlots Json?
  status        RescheduleStatus      @default(Pending)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
}

model AvailabilitySlot {
  id          String   @id @default(uuid())
  employeeId  String?
  candidateId String?
  startTime   DateTime
  endTime     DateTime
  isBooked    Boolean  @default(false)
  createdAt   DateTime @default(now())

  employee  Employee?  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  candidate Candidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([candidateId])
  @@index([startTime, endTime])
}

model TalentPool {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidates   TalentPoolCandidate[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model TalentPoolCandidate {
  id           String   @id @default(uuid())
  talentPoolId String
  candidateId  String
  addedAt      DateTime @default(now())

  talentPool TalentPool @relation(fields: [talentPoolId], references: [id], onDelete: Cascade)
  candidate  Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([talentPoolId, candidateId])
  @@index([talentPoolId])
  @@index([candidateId])
}

model CandidatePlan {
  id                  String                  @id @default(uuid())
  name                String                  @unique // "Free", "Prep Pro", "Prep Unlimited"
  price               Int // Price in cents
  mockInterviewsLimit Int // e.g. 2 for Free, 20 for Pro, -1 for Unlimited
  codingPracticeLimit Int // e.g. 5 for Free, 100 for Pro, -1 for Unlimited
  resumeReviewsLimit  Int // e.g. 1 for Free, 10 for Pro, -1 for Unlimited
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  subscriptions       CandidateSubscription[]
}

model CandidateSubscription {
  id                     String    @id @default(uuid())
  userId                 String    @unique
  planId                 String
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan CandidatePlan @relation(fields: [planId], references: [id], onDelete: Restrict)
}

model PracticeSession {
  id              String   @id @default(uuid())
  candidateId     String
  title           String // e.g. "Mock System Design Practice"
  roleCategory    String // e.g. "Backend Engineer"
  overallScore    Int? // AI Score (0-100)
  voiceScore      Int?
  transcript      String?  @db.Text
  aiFeedback      String?  @db.Text
  improvementTips Json? // Actionable feedback from Gemini
  createdAt       DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model ResumeReview {
  id                String   @id @default(uuid())
  candidateId       String
  targetRole        String // e.g. "Full Stack Developer"
  resumeUrl         String?
  atsScore          Int? // AI ATS score (0-100)
  keywordMatchScore Int? // Keyword match score
  strengths         Json? // Highlighted strengths
  improvements      Json? // Suggested improvements
  missingKeywords   String[] // Missing keywords list
  createdAt         DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model SavedJob {
  id          String   @id @default(uuid())
  candidateId String
  jobId       String
  savedAt     DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([candidateId, jobId])
  @@index([candidateId])
  @@index([jobId])
}

model RateLimit {
  id        String   @id @default(uuid())
  key       String   @unique
  points    Int      @default(0)
  expiresAt DateTime

  @@index([key])
  @@index([expiresAt])
}
